# All optional - the app degrades gracefully (mock data / fallbacks) when a key is missing.
LLM_PROVIDER=gemini            # gemini | groq (first choice; the other is the fallback)
LLM_CACHE=on                   # off = always call the live model (replay cache in llm_cache/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
TAVILY_API_KEY=
COMPANIES_HOUSE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Google (Gmail + Calendar): run scripts/google_auth.py once locally to get these
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
